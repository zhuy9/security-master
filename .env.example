# Copy to .env (git-ignored) and fill in. src/build.py reads it; variables already set in the
# environment (the GitHub Actions secrets, for one) take precedence.

# Required. SEC asks every automated client to identify itself as "Name email".
EDGAR_IDENTITY="Your Name you@example.com"

# Optional, free from https://www.openfigi.com/api. Without it a daily build takes about 50
# minutes instead of about 6.
OPENFIGI_API_KEY=
